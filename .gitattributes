# Text files: consistent LF line endings
.gitattributes text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf
LICENSE-MIT text eol=lf
Makefile text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cff text eol=lf
*.typ text eol=lf
*.bib text eol=lf

# Binaries: never modify
*.pdf binary
*.png binary
*.ttf binary
